def _ratio(b):
    w, h = _Im.open(b['src']).size; return h / w
def is_portrait(b): return bool(b) and b['src'] not in DROP and _ratio(b) > 1.05

def band(b, h=None, pos=None):
    """a photograph whole, at its own proportions (290px tall, a portrait 340px), its caption beside it"""
    if not b or b['src'] in DROP: return ''
    cap = cap_text(b); r = _ratio(b); w = min(652, round((340 if r > 1.05 else 290) / r)); hh = round(w * r)
    beside = cap and 652 - w >= 180
    return (f'<figure class="band{" bes" if beside else ""}" style="grid-template-columns:{w}px 1fr"><img src="{b["src"]}" style="width:{w}px;height:{hh}px">'
            f'{f"<figcaption>{esc(cap)}</figcaption>" if cap else ""}</figure>')

def side(b):
    """a photograph in the 264px margin, whole"""
    if not b or b['src'] in DROP: return ''
    cap = cap_text(b)
    return f'<figure class="side"><img src="{b["src"]}" style="width:264px;height:{round(264 * _ratio(b))}px">{f"<figcaption>{esc(cap)}</figcaption>" if cap else ""}</figure>'

def margin(photos, extra=''):
    """the right margin of a text page: its portrait photographs whole, then the apparatus"""
    inner = ''.join(side(p) for p in photos if is_portrait(p)) + extra
    return f'<div class="aside">{inner}</div>' if inner else ''

def _txt_h(ps):
    """the height a run of paragraphs takes in the 340px column (≈66 characters a 17.5px line)"""
    return sum((-(-len(re.sub(r'<[^>]+>', '', p)) // 66)) * 17.5 + 11 for p in ps)
def side_h(b):
    cap = cap_text(b); return 264 * _ratio(b) + 18 + ((-(-len(cap) // 42)) * 13 + 8 if cap else 0)

def fit_margin(photos, lead_texts, name=''):
    """portraits in the margin only while they stand beside the lead text; the rest left out"""
    room = _txt_h(lead_texts) + 40; inner, used = '', 0
    for ph in photos:
        if not is_portrait(ph): continue
        if used + side_h(ph) <= room: inner += side(ph); used += side_h(ph)
        else: print('  margin full, left out:', name, ph['src'])
    return f'<div class="aside">{inner}</div>' if inner else ''

def xrefs(body):
    """the decisions an essay sends the reader to — the margin works"""
    ds = sorted(set(re.findall(r'Decision (0\d)', body)))
    if not ds: return ''
    return ('<div class="xr"><span class="lab">The calls this chapter decides</span>'
            + ''.join(f'<a href="#d{d}" class="it"><span class="n">{d}</span><span class="t">{esc(BY["d" + d]["title"])}</span></a>' for d in ds) + '</div>')

def photo_page(b, tail_html, vol_html='', duo=None, pos='50% 50%'):
    cap = cap_text(b); two = bool(vol_html); twop = tail_html.count('<p') > 1
    img = (f'<div class="dw"><img src="{b["src"]}" style="object-position:{pos}"><div class="tone"></div><div class="lift"></div>'
           f'<div class="word" style="font-size:{marta2.WORD[duo][1]}px;font-stretch:{marta2.WORD[duo][2]}%">{esc(marta2.WORD[duo][0])}</div></div>') if duo else f'<img src="{b["src"]}" style="object-position:{pos}">'
    return (f'<div class="photo{" duo" if duo else ""}">{img}<div class="tail{"" if two else " one"}{" two" if twop else ""}">'
            f'<div>{f"<div class=cap>{esc(cap)}</div>" if cap else ""}{tail_html}</div>{vol_html}</div></div>')

def paper_poster(cid, label, title, thesis, red, foot_big, foot_p):
    t = esc(thesis)
    if red and red in thesis: t = esc(thesis).replace(esc(red), f'<em>{esc(red)}</em>', 1)
    return (f'<div class="poster paper" id="{cid}-p"><span class="rh-src">{esc(title)}</span>'
            f'<div class="slug"><span class="lab">{esc(label)}</span><span>{esc(title)}</span></div>'
            f'<div class="thesis{" long" if len(thesis) > 100 else ""}">{t}</div>'
            f'<div class="foot rule"><div class="big">{esc(foot_big)}</div><p>{esc(foot_p)}</p></div></div>')

def title_html(t): return f'<h1{" class=long" if len(t) > 38 else ""}>{esc(t)}</h1>'

def balanced(items, cls='cols2'):
    w = [len(re.sub(r'<[^>]+>', '', x)) + 120 for x in items]
    k = min(range(1, len(items) + 1), key=lambda k: abs(sum(w[:k]) - sum(w[k:]))) if len(items) > 1 else 1
    return f'<div class="{cls}"><div>{"".join(items[:k])}</div><div>{"".join(items[k:])}</div></div>'

def stack_html(d, picks):
    rows = ''
    for i, r in enumerate(d['rows']):
        opt = strip_mk(r['opt']); sub = ''
        if ' — ' in opt: opt, sub = opt.split(' — ', 1)
        rows += (f'<div class="it{" pick" if i in picks else ""}"><div class="opt">{esc(opt)}</div>'
                 f'{f"<div class=sub>{esc(sub)}</div>" if sub else ""}<div class="v">{esc(" · ".join(r["vals"]))}</div></div>')
    cap = d['caption'].title() if d['caption'].isupper() else d['caption']
    return f'<div class="stack ledger{" sm" if len(d["rows"]) > 4 else ""}"><span class="lab">{esc(cap)}</span>{rows}</div>'

def forks_html(b):
    out = '<div class="forks">'; last = None
    for it in b['items']:
        if it['lab'] != last: out += f'<span class="lab">{esc(it["lab"])}</span>'; last = it['lab']
        cond, _, cons = it['text'].partition(' → ')
        out += f'<div class="it"><div class="q">{cond}</div>{f"<p>→ {cons}</p>" if cons else ""}</div>'
    return out + '</div>'

def forks2_html(b):
    """The forks under the prose: one column per label (Follow this if / Overrule it if)."""
    cols = {}
    for it in b['items']:
        cond, _, cons = it['text'].partition(' → ')
        cols.setdefault(it['lab'], []).append(f'<div class="it"><div class="q">{cond}</div>{f"<p>→ {cons}</p>" if cons else ""}</div>')
    return '<div class="forks2">' + ''.join(f'<div class="forks"><span class="lab">{esc(k)}</span>{"".join(v)}</div>' for k, v in cols.items()) + '</div>'

def vol_html(note, xref):
    if not note and not xref: return ''
    lab = '<i class="mk">◆</i> Volatile' if (note and '◆' in note['text']) else 'Note'
    return f'<div class="vol"><span class="lab">{lab}</span><p>{note["text"] if note else ""}{f"<span class=x>{esc(xref[chr(116)+chr(101)+chr(120)+chr(116)])}</span>" if xref else ""}</p></div>'

def lines_html(b):
