/* ═══════════════════════════════════════════════════════════════════
   Barcelona, Without the Traps. — the dossier stylesheet
   Page geometry per page-spec.md (US Letter 816×1056 @96dpi).
   Palette derived from L'Entrada globals.css (see assets/brands/…json).
   Fonts by FILE URL (never base64 — the paginator stalls on data-URIs).
   ═══════════════════════════════════════════════════════════════════ */

@font-face{ font-family:'Anton'; src:url('assets/fonts/Anton-Regular.ttf'); font-weight:400; }
@font-face{ font-family:'Goudy'; src:url('assets/fonts/SortsMillGoudy-Regular.ttf'); font-weight:400; font-style:normal; }
@font-face{ font-family:'Goudy'; src:url('assets/fonts/SortsMillGoudy-Italic.ttf'); font-weight:400; font-style:italic; }
@font-face{ font-family:'Plex'; src:url('assets/fonts/IBMPlexMono-Regular.ttf'); font-weight:400; }
@font-face{ font-family:'Plex'; src:url('assets/fonts/IBMPlexMono-Medium.ttf'); font-weight:500; }
@font-face{ font-family:'Public'; src:url('assets/fonts/PublicSans-Variable.ttf'); font-weight:400 700; }

:root{
  --paper:#F2F7F5; --ink:#1B2622; --accent:#0E6390; --deep:#0B4E70;
  --gilt:#E0A828; --brass:#A23520; --line:#D3DED9; --muted:#5B6B66;
  --display:'Anton',sans-serif; --body:'Goudy',Georgia,serif;
  --mono:'Plex',monospace; --sans:'Public',system-ui,sans-serif;
}

/* ── PAGE MODEL (Paged.js furnishes these margin boxes on every sheet) ── */
@page{
  size:8.5in 11in;
  margin:92px 82px 72px 82px;
  @top-left{ content:"Barcelona, Without the Traps." }
  @top-right{ content:string(rh, last) }
  @bottom-left{ content:"Barcelona for Americans" }
  @bottom-center{ content:"\25c6" }
  @bottom-right{ content:counter(page) }
}
@page cover{ margin:0;
  @top-left{content:none} @top-right{content:none}
  @bottom-left{content:none} @bottom-center{content:none} @bottom-right{content:none} }
@page annex{ margin:92px 82px 76px 82px; }
.coverpage{ page:cover; }
.fs{ page:annex; }

html,body{ background:var(--paper); -webkit-print-color-adjust:exact; print-color-adjust:exact; margin:0; }
.pagedjs_sheet{ background:var(--paper); }
body{ font-family:var(--body); color:var(--ink); font-size:12.5px; line-height:1.52; }

/* running-head string — ONE selector only */
.rh-src{ string-set: rh content(text); display:block; height:0; overflow:hidden; font-size:0; line-height:0; margin:0; }

.pagedjs_margin-top-left .pagedjs_margin-content,
.pagedjs_margin-top-right .pagedjs_margin-content{
  font-family:var(--mono); font-size:8.5px; letter-spacing:.13em; color:var(--muted); text-transform:uppercase; }
.pagedjs_margin-bottom-left .pagedjs_margin-content,
.pagedjs_margin-bottom-right .pagedjs_margin-content{
  font-family:var(--mono); font-size:8.5px; letter-spacing:.1em; color:var(--muted); }
.pagedjs_margin-bottom-center .pagedjs_margin-content{ color:var(--gilt); font-size:7px; }

/* ── SECTION / CHAPTER ── */
section{ break-before:page; }
section.cont{ break-before:auto; }

h1{ font-family:var(--display); font-weight:400; font-size:33px; line-height:.98;
  letter-spacing:.005em; color:var(--deep); text-transform:uppercase; margin:0 0 2px; }
.kicker{ font-family:var(--mono); font-size:9px; letter-spacing:.2em; text-transform:uppercase;
  color:var(--brass); margin:0 0 14px; display:flex; align-items:center; gap:9px; }
.kicker::before{ content:''; width:26px; height:2px; background:var(--gilt); display:inline-block; }

.standfirst{ font-family:var(--body); font-style:italic; font-size:14.5px; line-height:1.4;
  color:var(--deep); margin:0 0 10px; padding:0 0 12px; border-bottom:1px solid var(--line); }

h2{ font-family:var(--display); font-weight:400; font-size:16px; letter-spacing:.01em;
  color:var(--deep); text-transform:uppercase; margin:20px 0 7px; }
h3{ font-family:var(--sans); font-weight:700; font-size:11.5px; letter-spacing:.02em;
  color:var(--ink); margin:14px 0 4px; }

p{ margin:0 0 8.5px; text-align:justify; hyphens:auto; }
p.first{ text-indent:0; }
p+p{ text-indent:1.1em; }

/* drop cap — chapter opener only */
.dropcap::first-letter{
  font-family:var(--display); float:left; font-size:52px; line-height:.82;
  padding:4px 8px 0 0; color:var(--brass); }

/* ── PROVENANCE MARKS ── */
.mk{ font-family:var(--mono); font-size:.82em; vertical-align:.08em; }
.mk.est{ color:var(--accent); }      /* ● established */
.mk.off{ color:var(--deep); }        /* ◇ official */
.mk.sur{ color:var(--gilt); }        /* ▲ surveyed */
.mk.vol{ color:var(--brass); }       /* ◆ volatile → Field Sheet */

/* ── DECISION LEDGER ── */
/* Decisions FLOW across pages (a fixed page per decision is the padding failure
   mode). Only the small blocks below resist breaking. */
.decision{ }
.ledger{ width:100%; border-collapse:collapse; margin:11px 0 10px; font-size:11px; }
.ledger caption{ font-family:var(--mono); font-size:8.5px; letter-spacing:.09em; text-transform:uppercase;
  color:var(--muted); text-align:left; padding:0 0 6px; }
.ledger th{ font-family:var(--mono); font-size:7.8px; letter-spacing:.1em; text-transform:uppercase;
  color:var(--brass); text-align:left; padding:0 8px 5px 0; border-bottom:1.5px solid var(--deep);
  vertical-align:bottom; }
.ledger th.num{ text-align:right; white-space:nowrap; }
.ledger td{ padding:7px 8px 7px 0; border-bottom:1px solid var(--line); vertical-align:top;
  font-family:var(--body); line-height:1.34; }
.ledger td.num{ text-align:right; font-family:var(--mono); font-size:10px; color:var(--deep);
  white-space:nowrap; font-weight:500; }
.ledger .opt{ font-family:var(--sans); font-weight:700; font-size:10.5px; color:var(--ink); }
.ledger .sub{ color:var(--muted); font-size:10px; }

.verdict{ background:rgba(14,99,144,.06); border-left:3px solid var(--gilt);
  padding:10px 14px; margin:10px 0; break-inside:avoid; }
.verdict p{ text-align:left; margin:0; text-indent:0; font-size:11.5px; line-height:1.46; }
.verdict strong{ color:var(--deep); }

.fa{ display:grid; grid-template-columns:1fr 1fr; gap:0 20px; margin:9px 0; font-size:10.5px; }
.fa .col{ }
.fa .lab{ font-family:var(--mono); font-size:8px; letter-spacing:.09em; text-transform:uppercase;
  color:var(--brass); display:block; margin:0 0 3px; border-top:2px solid var(--line); padding-top:5px; }
.fa p{ text-align:left; text-indent:0; margin:0 0 5px; line-height:1.38; }

.note{ font-family:var(--sans); font-size:9.5px; line-height:1.42; color:var(--muted);
  border-top:1px solid var(--line); padding-top:7px; margin-top:9px; }
.note .xref{ color:var(--accent); }

/* ── FIGURES (vector maps) ── */
figure{ margin:12px 0; break-inside:avoid; }
figure svg{ width:100%; height:auto; display:block; }
figcaption{ font-family:var(--mono); font-size:8px; letter-spacing:.06em; text-transform:uppercase;
  color:var(--muted); margin-top:6px; }

/* ── COVER ── */
.coverpage{ width:8.5in; height:11in; background:var(--deep); color:var(--paper);
  position:relative; overflow:hidden; display:flex; flex-direction:column; padding:0; }
.cv-band{ height:14px; background-image:radial-gradient(circle at 7px 50%, transparent 0 4.5px, var(--gilt) 4.5px 6px, transparent 6px); background-size:14px 14px; }
.cv-top{ display:flex; justify-content:space-between; font-family:var(--mono); font-size:9px;
  letter-spacing:.22em; text-transform:uppercase; color:var(--gilt); padding:20px 54px 0; }
.cv-mid{ flex:1; display:flex; flex-direction:column; justify-content:center; padding:0 54px; }
.cv-stamp{ align-self:flex-start; border:2px solid var(--gilt); color:var(--gilt); font-family:var(--mono);
  font-size:10px; letter-spacing:.14em; text-transform:uppercase; padding:7px 14px; transform:rotate(-3deg); margin-bottom:26px; }
.cv-mid h1{ font-family:var(--display); font-size:74px; line-height:.94; color:var(--paper); text-transform:uppercase; margin:0; }
.cv-mid h1 .b{ color:var(--gilt); }
.cv-sub{ font-family:var(--body); font-style:italic; font-size:17px; line-height:1.4; color:#CBE3EC;
  margin-top:22px; max-width:5in; }
.cv-rule{ display:flex; align-items:center; gap:12px; margin:28px 0; }
.cv-rule .seg{ flex:1; border-top:2px dashed rgba(242,247,245,.32); }
.cv-rule .d{ width:9px; height:9px; transform:rotate(45deg); background:var(--gilt); }
.cv-meta{ font-family:var(--mono); font-size:9px; letter-spacing:.04em; color:#CBE3EC; line-height:1.95; }
.cv-meta b{ color:var(--paper); }
.cv-foot{ display:flex; justify-content:space-between; font-family:var(--mono); font-size:8px;
  letter-spacing:.14em; text-transform:uppercase; color:rgba(203,227,236,.7); padding:0 54px 22px; }

/* ── HOW TO READ / marks key ── */
.markskey{ margin:10px 0; }
.markskey .row{ display:grid; grid-template-columns:28px 1fr; gap:10px; padding:6px 0; border-bottom:1px solid var(--line); font-size:11px; }
.markskey .g{ font-family:var(--mono); font-size:14px; text-align:center; }

/* ── TOC ── */
.toc{ margin-top:8px; }
.toc a{ display:flex; align-items:baseline; text-decoration:none; color:var(--ink); font-size:12px;
  padding:5.5px 0; border-bottom:1px solid var(--line); }
.toc .t{ font-family:var(--body); }
.toc .num{ font-family:var(--sans); font-weight:700; color:var(--brass); width:26px; }
.toc .dots{ flex:1; border-bottom:1px dotted var(--line); margin:0 8px; transform:translateY(-3px); }
.toc .pg{ font-family:var(--mono); font-size:10px; color:var(--muted); }
.toc a::after{ content: target-counter(attr(href), page); font-family:var(--mono); font-size:10px; color:var(--deep); }

/* ── checklist / failure modes / wallet ── */
ul.clean{ list-style:none; margin:8px 0; padding:0; }
ul.clean li{ padding:5px 0 5px 20px; position:relative; border-bottom:1px solid var(--line); font-size:11px; line-height:1.4; }
ul.clean li::before{ content:'\25c6'; position:absolute; left:0; top:5px; color:var(--gilt); font-size:9px; }
.deadline{ font-family:var(--mono); font-size:9px; color:var(--brass); text-transform:uppercase; letter-spacing:.05em; }

.fail{ break-inside:avoid; margin:11px 0; }
.fail .head{ font-family:var(--sans); font-weight:700; font-size:11px; color:var(--brass); }
.fail p{ text-align:left; text-indent:0; margin:2px 0 0; font-size:11px; }

.wallet{ border:2px solid var(--deep); border-radius:8px; padding:16px 18px; margin:12px 0; background:rgba(14,99,144,.04); }
.wallet h3{ margin-top:0; color:var(--deep); }
.wallet .line{ display:flex; justify-content:space-between; font-size:10.5px; padding:4px 0; border-bottom:1px dashed var(--line); }
.wallet .line .k{ font-family:var(--sans); font-weight:600; }
.wallet .line .v{ font-family:var(--mono); font-size:10px; color:var(--deep); text-align:right; }

.backmatter{ font-style:italic; color:var(--muted); }

/* ── Field Sheet ── */
.fs h1{ color:var(--brass); }
.fstable{ width:100%; border-collapse:collapse; font-size:10.5px; margin:10px 0; }
.fstable th{ font-family:var(--mono); font-size:8px; letter-spacing:.08em; text-transform:uppercase;
  color:var(--brass); text-align:left; padding:0 8px 5px 0; border-bottom:1.5px solid var(--deep); }
.fstable td{ padding:6px 8px 6px 0; border-bottom:1px solid var(--line); font-family:var(--body); }
.fstable td.n{ font-family:var(--mono); text-align:right; color:var(--deep); white-space:nowrap; }
.fsdate{ font-family:var(--mono); font-size:9px; color:var(--brass); text-transform:uppercase; letter-spacing:.08em; }

/* ── PHOTOGRAPHIC PLATES ──────────────────────────────────────────────────
   3:2 landscape only. Heights fixed so a plate never dominates a page; the
   ARGUING figure (map, chart, diagram) still leads any page it shares. */
.photo{ margin:13px 0 12px; break-inside:avoid; }
.photo img{ width:100%; display:block; object-fit:cover; border-radius:2px; }
.photo.wide img{ height:2.25in; }
.photo.band img{ height:2.35in; }
.photo figcaption{
  font-family:var(--mono); font-size:8px; letter-spacing:.06em; text-transform:uppercase;
  color:var(--muted); margin-top:6px; }
.photo figcaption .pl{ color:var(--brass); font-weight:500; }

/* cover evidence strip */
.cv-strip{ height:1.72in; overflow:hidden; border-top:1px solid rgba(224,168,40,.5);
  border-bottom:1px solid rgba(224,168,40,.5); }
.cv-strip img{ width:100%; height:100%; object-fit:cover; display:block; opacity:.92; }
