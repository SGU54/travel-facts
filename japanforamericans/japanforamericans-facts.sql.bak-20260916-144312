insert into common.facts (scope, key, value, status, checked_at, source_url)
values ('japan', 'entry.visa_free_days', '"90 days"'::jsonb, 'verified', now(),
        'https://www.mofa.go.jp/j_info/visit/visa/short/novisa.html')
